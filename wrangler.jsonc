{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nnnnn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "175f3d02-23cb-44e6-9b5c-34ce7b691346","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e89dc0d771bd4844b5c625a1e84863fa" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
